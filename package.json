{
  "name": "ccswap-ts",
  "private": true,
  "version": "0.49.0",
  "description": "TypeScript port of ccswap commands (strangler wave 2: reads plus file-backed mutations)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src-ts/main.ts --bundle --platform=node --format=esm --outfile=dist/ccswap.mjs --banner:js=\"#!/usr/bin/env node\"",
    "test": "vitest run",
    "lint": "eslint src-ts tests-ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.34.0",
    "@jstack/standards-ts": "github:jaykang-heo/jstack#standards-ts-v0.1.0&path:/standards/ts",
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vitest": "3.2.4"
  }
}
